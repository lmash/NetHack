// Item finder memory (Phase 3), on test/golden/lua/golden_items.lua.
// Wizard mode, for #wizloaddes, #wizitemmem (lists what is remembered)
// and ^V (level teleport).
seed: 42
faketime: 2026-03-10T12:00:00Z
wizard: yes
options: name:golden,role:valkyrie,race:human,gender:female,align:lawful,!autopickup,!legacy,!splash_screen,!tutorial,time,showexp,!mail,!tips
---
#wizloaddes<ret>
golden_items<ret>
#wizitemmem<ret>
// from a distance: containers' contents unknown, only the pile's top item,
// nothing in the dark room or behind the shop's closed door
!screen-has a large box (contents unknown)
!screen-has a chest (contents unknown)
!screen-has a ring mail
!screen-lacks apple
!screen-lacks lock pick
!screen-lacks scroll
!screen-lacks potion
!screen-lacks gem
!screen-lacks wand
!screen-lacks for sale
<ret>
// standing on the pile: the whole pile is remembered
nlllllll
<ret>
#wizitemmem<ret>
!screen-has 3 apples
!screen-has a lock pick
<ret>
// picking up forgets; dropping one step away remembers them there
,
b<ret>
