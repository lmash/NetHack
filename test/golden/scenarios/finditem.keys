// Item finder search (Phase 4), on test/golden/lua/golden_items.lua.
// Wizard mode, for #wizloaddes, ^W (wish) and ^V (level teleport).
seed: 42
faketime: 2026-03-10T12:00:00Z
wizard: yes
options: name:golden,role:valkyrie,race:human,gender:female,align:lawful,!autopickup,!legacy,!splash_screen,!tutorial,time,showexp,!mail,!tips
---
#wizloaddes<ret>
golden_items<ret>
// look inside the large box (a scroll and a blessed potion; the hero
// doesn't know either one, nor that the potion is blessed)
u
#loot<ret>
:
<ret>
q
// search by text; picking a result shows its square on the level map
#finditem<ret>
potion<ret>
!screen-has  On the floor
!screen-has     an unlocked large box, last seen T:
!screen-has a -   a clear potion, last seen T:
a
!screen-has item at cursor
<esc>
// matching ignores case
#finditem<ret>
elbib<ret>
!screen-has a -   a scroll labeled ELBIB YLOH, last seen T:
<esc>
// the wand in the dark room hasn't been seen
#finditem<ret>
wand<ret>
!screen-has You don't remember seeing anything like "wand".
// filters ('m' prefix); BUC only as far as the hero knows
m#finditem<ret>
B<ret>
<ret>
!screen-has You don't remember seeing any such items.
m#finditem<ret>
X!<ret>
<ret>
!screen-has a clear potion
!screen-lacks scroll
<esc>
m#finditem<ret>
?<ret>
<ret>
!screen-has a scroll labeled ELBIB YLOH
!screen-lacks potion
<esc>
m#finditem<ret>
I<ret>
<ret>
!screen-has a clear potion
!screen-has a scroll labeled ELBIB YLOH
!screen-lacks ring mail
<esc>
// names use today's knowledge: once scrolls of light are known, the one in
// the box is found as one
<C-w>
uncursed<sp>scroll<sp>of<sp>light<ret>
re
#finditem<ret>
light<ret>
!screen-has a -   a scroll of light, last seen T:
!screen-lacks ELBIB
<esc>
// the shop: goods are found with their price; 'F' shows only shop goods
n
llllllllll
ol
ol
lllll
l
l
<ret>
m#finditem<ret>
F<ret>
<ret>
!screen-has  For sale
!screen-has a - 6 rocks, 42 zorkmids, last seen T:
!screen-lacks On the floor
!screen-lacks large box
<esc>
// from another level: results are grouped by level, then the floor
// (a container's contents indented under it) and shop goods; picking a
// Dlvl 1 item shows Dlvl 1's remembered map
<C-v>
3<ret>
#finditem<ret>
<ret>
!screen-has The Dungeons of Doom: level 1
!screen-has a - an unlocked large box, last seen T:
!screen-has b -   a clear potion, last seen T:
!screen-has c -   a scroll of light, last seen T:
!screen-has  For sale
!same-map results
a
!screen-has The Dungeons of Doom, Level 1:
!screen-has item at cursor
<esc>
// searching took no time
!screen-has T:24
// save and restore: the same results
S
y
!restart
<ret>
// wizard mode only: keep the save file?
n
#finditem<ret>
<ret>
!same-map results
<esc>
// corpses are remembered but not listed (they rot); other food is listed.
// Wish for a corpse and an apple, drop them, look at the pile.
<C-w>
newt<sp>corpse<ret>
!screen-has e - a newt corpse.
<C-w>
apple<ret>
!screen-has f - an apple.
de
df
:
!screen-has newt corpse
!screen-has apple
<ret>
#wizitemmem<ret>
!screen-has newt corpse
<esc>
#finditem<ret>
corpse<ret>
!screen-has You don't remember seeing anything like "corpse".
#finditem<ret>
<ret>
!screen-has The Dungeons of Doom: level 3 <- You are here.
!screen-has an apple, last seen T:
!screen-lacks corpse
<esc>
m#finditem<ret>
%<ret>
<ret>
!screen-has an apple, last seen T:
!screen-lacks corpse
!screen-lacks large box
<esc>
// quit
#quit<ret>
y
// wizard mode only: dump core?
n
// end-of-game questions: skip them all
q
